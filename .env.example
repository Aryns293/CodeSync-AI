# Copy this file to .env before running the server locally.
# cp .env.example .env

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5001
NODE_ENV=development

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/codesync

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate strong secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# The server throws a fatal error at startup if either of these is missing or
# left as the placeholder value — there is no silent fallback.
JWT_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret

# ─── Gemini AI ────────────────────────────────────────────────────────────────
# Obtain from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ─── JDoodle Code Execution (fallback when Docker sandbox is unavailable) ─────
# Obtain from https://www.jdoodle.com/compiler-api
JDOODLE_CLIENT_ID=your_jdoodle_client_id
JDOODLE_CLIENT_SECRET=your_jdoodle_client_secret

# ─── Docker Sandbox ───────────────────────────────────────────────────────────
# Optional: override the sandbox image name (default: realtime-ide-sandbox:latest)
# Build the image once with: docker build -t realtime-ide-sandbox ./backend/execution-image
# SANDBOX_IMAGE=realtime-ide-sandbox:latest

# Optional: set to false to skip Docker and use JDoodle when configured.
USE_DOCKER_SANDBOX=true

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash).
# Example for local dev: http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
